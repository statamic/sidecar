{
    "name": "statamic/sidecar",
    "description": "Edit your static site generator's markdown content in the Statamic Control Panel",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "statamic/cms": "^6.0"
    },
    "require-dev": {
        "laravel/pint": "^1.30",
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^11.5.3 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "Statamic\\Sidecar\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Statamic\\Sidecar\\Tests\\": "tests"
        }
    },
    "extra": {
        "statamic": {
            "name": "Sidecar",
            "description": "Edit your static site generator's markdown content in the Statamic Control Panel"
        },
        "laravel": {
            "providers": [
                "Statamic\\Sidecar\\ServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pixelfear/composer-dist-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
